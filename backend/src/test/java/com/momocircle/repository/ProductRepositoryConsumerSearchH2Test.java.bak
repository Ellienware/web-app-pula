
package com.momocircle.repository;

import com.momocircle.domain.Product;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.jdbc.AutoConfigureTestDatabase;
import org.springframework.boot.test.autoconfigure.orm.jpa.DataJpaTest;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.PageRequest;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.transaction.annotation.Propagation;
import org.springframework.transaction.annotation.Transactional;

import java.math.BigDecimal;
import java.sql.Timestamp;
import java.time.Instant;
import java.util.UUID;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertTrue;

@DataJpaTest
@AutoConfigureTestDatabase(replace = AutoConfigureTestDatabase.Replace.NONE)
@Transactional(propagation = Propagation.NOT_SUPPORTED)
class ProductRepositoryConsumerSearchH2Test {

    @Autowired
    private ProductRepository products;

    @Autowired
    private JdbcTemplate jdbc;

    @Test
    void consumerSearchExcludesWholesaleOnlyProductsButGeneralSearchKeepsThem() {
        String suffix = UUID.randomUUID().toString().substring(0, 8);
        String consumerOwnerId = createUser("consumer-owner-" + suffix);
        String wholesaleOwnerId = createUser("wholesale-owner-" + suffix);

        String consumerBusinessId = createBusiness(consumerOwnerId, "Spaza " + suffix);
        String wholesaleBusinessId = createBusiness(wholesaleOwnerId, "Wholesaler " + suffix);

        addCapability(consumerBusinessId, "CAN_SELL_TO_CONSUMERS");
        addCapability(wholesaleBusinessId, "CAN_SUPPLY_BUSINESSES");

        createActiveProduct(consumerBusinessId, "RegressionWidget " + suffix);
        createActiveProduct(wholesaleBusinessId, "RegressionWidget " + suffix);

        PageRequest page = PageRequest.of(0, 20);

        Page<Product> consumerResults =
                products.searchConsumer("RegressionWidget " + suffix, null, page);
        Page<Product> generalResults =
                products.search("RegressionWidget " + suffix, null, page);

        assertEquals(1, consumerResults.getTotalElements(),
                "Consumer search must exclude wholesale-only businesses");
        assertTrue(consumerResults.getContent().stream()
                        .allMatch(p -> p.getBusiness().getId().equals(consumerBusinessId)),
                "Consumer search should return only the consumer-facing seller's product");

        assertEquals(2, generalResults.getTotalElements(),
                "General product search should retain wholesale catalogue visibility");
    }

    private String createUser(String email) {
        String id = UUID.randomUUID().toString();
        Timestamp now = Timestamp.from(Instant.now());

        jdbc.update(
                "insert into users (id, created_at, updated_at, email, full_name, phone_number, password_hash, role, active) "
                        + "values (?, ?, ?, ?, ?, ?, ?, ?, ?)",
                id, now, now, email, "Repository Test User",
                "+27820000000", "test-hash", "USER", true);

        return id;
    }

    private String createBusiness(String ownerId, String name) {
        String id = UUID.randomUUID().toString();
        Timestamp now = Timestamp.from(Instant.now());

        jdbc.update(
                "insert into businesses "
                        + "(id, created_at, updated_at, owner_id, name, category, active, rating_average, rating_count, business_type, registration_status) "
                        + "values (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
                id, now, now, ownerId, name, "General", true,
                BigDecimal.ZERO, 0, "LOCAL_BUSINESS", "NOT_REGISTERED");

        return id;
    }

    private void addCapability(String businessId, String capability) {
        jdbc.update(
                "insert into business_capabilities (business_id, capability) values (?, ?)",
                businessId, capability);
    }

    private void createActiveProduct(String businessId, String name) {
        String id = UUID.randomUUID().toString();
        Timestamp now = Timestamp.from(Instant.now());

        jdbc.update(
                "insert into products "
                        + "(id, created_at, updated_at, business_id, name, category, price, currency, is_service, stock, status, rating_average, rating_count, match_classification) "
                        + "values (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
                id, now, now, businessId, name, "Regression",
                new BigDecimal("10.00"), "ZAR", false, 100,
                "ACTIVE", BigDecimal.ZERO, 0, "UNIQUE_PRODUCT");
    }
}
